# ========================================
# Muwāsā Environment Configuration
# ========================================
# Copy this to .env and fill in your values

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql://postgres.your-project:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# LLM Providers
OPENAI_API_KEY=sk-your-openai-key
# ANTHROPIC_API_KEY=sk-ant-your-key
# GOOGLE_API_KEY=your-google-key

# Embedding Model
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024

# LLM Model Selection
LLM_MODEL=gpt-4o
SAFETY_MODEL=gpt-4o-mini
CLASSIFIER_MODEL=gpt-4o-mini
SUMMARIZER_MODEL=gpt-4o-mini

# Reranker
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# COHERE_API_KEY=your-cohere-key  # If using Cohere Rerank

# Redis / Valkey (for local dev)
REDIS_URL=redis://localhost:6379

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Security
JWT_SECRET=change-this-to-a-random-secret-in-production
SESSION_TTL_SECONDS=86400

# Islamic KB
KB_VERSION=1.0.0
TANZIL_ATTRIBUTION="Tanzil Project — tanzil.net"
QURANENC_ATTRIBUTION="QuranEnc.com"
HADEETHENC_ATTRIBUTION="HadeethEnc.com"

# Safety
CRISIS_HOTLINE_US=988
CRISIS_TEXT_US="Text HOME to 741741"
CRISIS_HOTLINE_UK=116123
