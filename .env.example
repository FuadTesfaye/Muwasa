# ==============================================================================
# Muwāsā (مُوَاسَاة) — Environment Configuration
# ==============================================================================
# Copy this file to `.env.local` for local development or add to your Vercel Project Settings.

# ------------------------------------------------------------------------------
# 1. Google Gemini AI & Embeddings (Required for live AI responses)
# ------------------------------------------------------------------------------
# Get your free key at: https://aistudio.google.com
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# ------------------------------------------------------------------------------
# 2. PostgreSQL with pgvector (Required for persistent chats & vector search)
# ------------------------------------------------------------------------------
# Recommended: Free serverless PostgreSQL on Neon (https://neon.tech) or Supabase (https://supabase.com)
DATABASE_URL="postgresql://user:password@your-neon-host.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 3. Upstash Redis (Required for sliding-window rate limiting & caching)
# ------------------------------------------------------------------------------
# Get your free serverless Redis at: https://upstash.com
UPSTASH_REDIS_REST_URL="https://your-upstash-redis-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_token_here"

# ------------------------------------------------------------------------------
# 4. Better Auth (Required for user authentication & session management)
# ------------------------------------------------------------------------------
# Generate a random 32-character secret: openssl rand -base64 32
BETTER_AUTH_SECRET="your_random_32_character_secret_here"
BETTER_AUTH_URL="http://localhost:3000" # Use your production domain on Vercel, e.g. https://muwasa.vercel.app

# ------------------------------------------------------------------------------
# 5. Quran Foundation API (Optional — for direct external live verification)
# ------------------------------------------------------------------------------
# https://quran.foundation
QF_CLIENT_ID=""
QF_CLIENT_SECRET=""
